# Kopier til .env.local og fyll inn fra Supabase Dashboard → Project Settings → API.
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Engelsk arveveiviser (true/false). Skal være av i produksjon til de engelske tekstene er juridisk gjennomgått.
VITE_GUIDE_EN=false
